# Base URL of the deployed backend API (include the /api suffix).
# Create React App bakes this value into the production build at BUILD time,
# so this file must exist (as .env, not .env.example) and be set correctly
# BEFORE you run `npm run build`. Changing it later requires a rebuild.
#
# Local development example:
# REACT_APP_API_URL=http://localhost:5000/api
#
# Production example:
# REACT_APP_API_URL=https://api.yourdomain.com/api
REACT_APP_API_URL=http://localhost:5000/api
